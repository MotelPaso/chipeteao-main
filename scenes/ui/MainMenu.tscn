[ext_resource type="PackedScene" path="res://scenes/ui/SettingsPanel.tscn" id="4_settings"]
[ext_resource type="FontFile" path="res://assets/ui/fonts/LilitaOne-Regular.ttf" id="5_display"]

[ext_resource type="Texture2D" path="res://assets/ui/icons/menu_quests.svg" id="6_quests"]
[ext_resource type="Texture2D" path="res://assets/ui/icons/menu_collection.svg" id="7_collection"]
[ext_resource type="Texture2D" path="res://assets/ui/icons/menu_armory.svg" id="8_armory"]
