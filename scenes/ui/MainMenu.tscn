[node name="MainMenu" type="Control" groups=["menu_screen"]]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_menu")

[node name="Background" type="ColorRect" parent="."]
material = ExtResource("2_backdrop")
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
mouse_filter = 2

[node name="Layout" type="MarginContainer" parent="."]
unique_name_in_owner = true
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
theme_override_constants/margin_left = 44
theme_override_constants/margin_top = 36
theme_override_constants/margin_right = 44
theme_override_constants/margin_bottom = 16

[node name="VBox" type="VBoxContainer" parent="Layout"]
editor_description = "La separación deja aire para que la tarjeta con foco (crece, anillo y sombra más larga) no pise el subtítulo ni los botones de abajo."
layout_mode = 2
theme_override_constants/separation = 32

[node name="TopBar" type="HBoxContainer" parent="Layout/VBox"]
layout_mode = 2

[node name="Titles" type="VBoxContainer" parent="Layout/VBox/TopBar"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = -10

[node name="TitleLabel" type="Label" parent="Layout/VBox/TopBar/Titles"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"TitleLabel"
theme_override_constants/outline_size = 16
theme_override_fonts/font = ExtResource("5_display")
theme_override_font_sizes/font_size = 92
text = "CHIPETIAO"

[node name="SubtitleLabel" type="Label" parent="Layout/VBox/TopBar/Titles"]
layout_mode = 2
theme_override_constants/outline_size = 8
theme_override_font_sizes/font_size = 19
text = "Sobrevive a la horda. O por lo menos inténtalo."

[node name="ShardsLabel" type="Label" parent="Layout/VBox/TopBar"]
unique_name_in_owner = true
editor_description = "El texto lo escribe main_menu.gd con UiTheme.SHARDS_BALANCE."
layout_mode = 2
size_flags_vertical = 4
theme_type_variation = &"BadgeLabel"
theme_override_colors/font_color = Color(0.498, 0.831, 0.941, 1)
theme_override_font_sizes/font_size = 18
text = "Esquirlas: 0"

[node name="Tiles" type="HBoxContainer" parent="Layout/VBox"]
editor_description = "Las cuatro secciones. Cacería es más ancha (Layout > Stretch Ratio) porque es la acción principal. El texto, el color y el giro de cada tarjeta están en su instancia."
layout_mode = 2
size_flags_vertical = 3
theme_override_constants/separation = 26

[node name="HuntButton" parent="Layout/VBox/Tiles" instance=ExtResource("3_tile")]
unique_name_in_owner = true
layout_mode = 2
size_flags_stretch_ratio = 1.5
title_text = "Cacería"
detail_text = "Elige tu raider y sal de incursión."
tile_color = Color(1, 0.824, 0.247, 1)
tilt_degrees = -1.5
art_outline = 4.0
art_lit_tilt = 3.0

[node name="QuestsButton" parent="Layout/VBox/Tiles" instance=ExtResource("3_tile")]
unique_name_in_owner = true
layout_mode = 2
