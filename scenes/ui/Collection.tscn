[gd_scene load_steps=5 format=3]

[ext_resource type="Script" path="res://scripts/ui/meta/collection.gd" id="1_collection"]
[ext_resource type="Material" path="res://assets/ui/menu_backdrop.tres" id="2_backdrop"]
[ext_resource type="FontFile" path="res://assets/ui/fonts/LilitaOne-Regular.ttf" id="font_display"]

[sub_resource type="FontVariation" id="FontVariation_title"]
base_font = ExtResource("font_display")
spacing_glyph = 1

[node name="Collection" type="Control" groups=["menu_screen"]]
anchor_right = 1.0
anchor_bottom = 1.0
script = ExtResource("1_collection")

[node name="Background" type="ColorRect" parent="."]
material = ExtResource("2_backdrop")
anchor_right = 1.0
anchor_bottom = 1.0
color = Color(1, 1, 1, 1)

[node name="Center" type="CenterContainer" parent="."]
anchor_right = 1.0
anchor_bottom = 1.0

[node name="VBox" type="VBoxContainer" parent="Center"]
theme_override_constants/separation = 12

[node name="TitleLabel" type="Label" parent="Center/VBox"]
unique_name_in_owner = true
theme_override_colors/font_color = Color(1, 0.824, 0.247, 1)
theme_override_colors/font_outline_color = Color(0.082, 0.075, 0.102, 1)
theme_override_constants/outline_size = 10
theme_override_fonts/font = SubResource("FontVariation_title")
theme_override_font_sizes/font_size = 40
horizontal_alignment = 1
text = "COLECCIÓN"

[node name="BadgeLabel" type="Label" parent="Center/VBox"]
unique_name_in_owner = true
theme_override_colors/font_color = Color(0.357, 0.839, 0.627, 1)
theme_override_font_sizes/font_size = 18
horizontal_alignment = 1
text = "Colección: 0 / 0 — 0%"

[node name="Scroll" type="ScrollContainer" parent="Center/VBox"]
custom_minimum_size = Vector2(700, 420)
horizontal_scroll_mode = 0

[node name="List" type="VBoxContainer" parent="Center/VBox/Scroll"]
unique_name_in_owner = true
size_flags_horizontal = 3
theme_override_constants/separation = 8

[node name="BackButton" type="Button" parent="Center/VBox"]
unique_name_in_owner = true
custom_minimum_size = Vector2(200, 46)
size_flags_horizontal = 4
theme_override_font_sizes/font_size = 20
text = "Volver"
