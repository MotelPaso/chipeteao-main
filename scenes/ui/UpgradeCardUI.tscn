[sub_resource type="Shader" id="Shader_radialdim"]
code = "shader_type canvas_item;
// Oscurecido radial de la pantalla de elección: más oscuro en los bordes para
// que las cartas queden en un foco de luz. El alfa del fundido de entrada va
// en el modulate del rectángulo.
void fragment() {
	float d = length(UV - 0.5);
	float dark = mix(0.5, 0.92, smoothstep(0.12, 0.72, d));
	COLOR = vec4(vec3(0.018, 0.022, 0.04), dark);
}"

