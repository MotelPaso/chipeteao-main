[sub_resource type="Shader" id="Shader_radialdim"]
code = "shader_type canvas_item;
// Radial pick-screen dim: darker at the edges so the cards sit in a pool
// of focus. Alpha rides the rect's modulate for the fade-in.
void fragment() {
	float d = length(UV - 0.5);
	float dark = mix(0.5, 0.92, smoothstep(0.12, 0.72, d));
	COLOR = vec4(vec3(0.018, 0.022, 0.04), dark);
}"

