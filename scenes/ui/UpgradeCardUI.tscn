[gd_scene load_steps=4 format=3]

[ext_resource type="Script" path="res://scripts/ui/upgrade_card_ui.gd" id="1_cardui"]

[sub_resource type="Shader" id="Shader_radialdim"]
code = "shader_type canvas_item;
// Radial pick-screen dim: darker at the edges so the cards sit in a pool
// of focus. Alpha rides the rect's modulate for the fade-in.
void fragment() {
	float d = length(UV - 0.5);
	float dark = mix(0.5, 0.92, smoothstep(0.12, 0.72, d));
	COLOR = vec4(vec3(0.018, 0.022, 0.04), dark);
}"

[sub_resource type="ShaderMaterial" id="ShaderMaterial_radialdim"]
shader = SubResource("Shader_radialdim")

[node name="UpgradeCardUI" type="CanvasLayer"]
process_mode = 3
layer = 10
script = ExtResource("1_cardui")

