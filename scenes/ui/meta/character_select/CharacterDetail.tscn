[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/ui/meta/character_select/character_detail.gd" id="1_detail"]
[ext_resource type="PackedScene" path="res://scenes/ui/meta/character_select/CharacterPortrait.tscn" id="2_portrait"]

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_price"]
content_margin_left = 12.0
content_margin_top = 3.0
content_margin_right = 12.0
content_margin_bottom = 3.0
bg_color = Color(0.07, 0.1, 0.14, 0.9)
border_width_left = 1
border_width_top = 1
border_width_right = 1
border_width_bottom = 1
border_color = Color(0.275, 0.4, 0.46, 1)
corner_radius_top_left = 7
corner_radius_top_right = 7
corner_radius_bottom_right = 7
corner_radius_bottom_left = 7

[node name="CharacterDetail" type="PanelContainer"]
custom_minimum_size = Vector2(400, 0)
mouse_filter = 2
script = ExtResource("1_detail")

[node name="Body" type="Control" parent="."]
editor_description = "No es un contenedor a propósito: Content se desliza aquí dentro al cambiar de raider (grupo Movimiento de character_detail.gd)."
layout_mode = 2
mouse_filter = 2

[node name="Content" type="VBoxContainer" parent="Body"]
editor_description = "Sin anclas: character_detail.gd le da el tamaño de Body, así mover su posición al deslizar no cambia su ancho."
layout_mode = 0
mouse_filter = 2
theme_override_constants/separation = 6

[node name="Portrait" parent="Body/Content" instance=ExtResource("2_portrait")]
unique_name_in_owner = true
layout_mode = 2
size_flags_vertical = 3

[node name="Info" type="VBoxContainer" parent="Body/Content"]
editor_description = "Su alto mínimo alcanza para el caso más largo (pasiva de dos líneas, descripción de tres y precio), así el retrato no cambia de tamaño al pasar de un raider a otro."
custom_minimum_size = Vector2(0, 214)
layout_mode = 2
mouse_filter = 2
theme_override_constants/separation = 6

[node name="Name" type="Label" parent="Body/Content/Info"]
unique_name_in_owner = true
layout_mode = 2
theme_override_colors/font_color = Color(0.96, 0.97, 0.99, 1)
theme_override_font_sizes/font_size = 26
text = "Rook"
horizontal_alignment = 1
autowrap_mode = 3

[node name="WeaponRow" type="HBoxContainer" parent="Body/Content/Info"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="Caption" type="Label" parent="Body/Content/Info/WeaponRow"]
custom_minimum_size = Vector2(58, 0)
layout_mode = 2
size_flags_vertical = 0
theme_override_colors/font_color = Color(0.47, 0.5, 0.56, 1)
theme_override_font_sizes/font_size = 13
text = "Arma"

[node name="Weapon" type="Label" parent="Body/Content/Info/WeaponRow"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
theme_override_colors/font_color = Color(0.85, 0.87, 0.9, 1)
theme_override_font_sizes/font_size = 15
text = "Espada corta"
autowrap_mode = 3

[node name="PassiveRow" type="HBoxContainer" parent="Body/Content/Info"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="Caption" type="Label" parent="Body/Content/Info/PassiveRow"]
custom_minimum_size = Vector2(58, 0)
layout_mode = 2
size_flags_vertical = 0
theme_override_colors/font_color = Color(0.47, 0.5, 0.56, 1)
theme_override_font_sizes/font_size = 13
text = "Pasiva"

[node name="Passive" type="Label" parent="Body/Content/Info/PassiveRow"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
theme_override_colors/font_color = Color(0.85, 0.78, 0.5, 1)
theme_override_font_sizes/font_size = 15
text = "+0.8% de daño por nivel"
autowrap_mode = 3

[node name="Blurb" type="Label" parent="Body/Content/Info"]
unique_name_in_owner = true
layout_mode = 2
theme_override_colors/font_color = Color(0.66, 0.69, 0.75, 1)
theme_override_font_sizes/font_size = 13
text = "Un muro con patas: sus golpes solo se ponen más feos."
autowrap_mode = 3

[node name="LockRow" type="VBoxContainer" parent="Body/Content/Info"]
unique_name_in_owner = true
visible = false
editor_description = "Solo se ve con un raider bloqueado: su precio y, si la fila del catálogo tiene unlock_hint, la pista del jefe."
layout_mode = 2
theme_override_constants/separation = 4

[node name="Price" type="Label" parent="Body/Content/Info/LockRow"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 0
theme_override_colors/font_color = Color(0.55, 0.8, 0.92, 1)
theme_override_font_sizes/font_size = 14
theme_override_styles/normal = SubResource("StyleBoxFlat_price")
text = "120 esquirlas"

[node name="Hint" type="Label" parent="Body/Content/Info/LockRow"]
unique_name_in_owner = true
visible = false
layout_mode = 2
theme_override_colors/font_color = Color(0.4125, 0.6, 0.69, 1)
theme_override_font_sizes/font_size = 13
autowrap_mode = 3
