[sub_resource type="Shader" id="Shader_sand"]
code = "shader_type spatial;

// Ash Dunes floor: the Hollow Woods two-tone value-noise treatment in
// warm tans at a broader cell scale, so patches read as drifted sand.
float cell_hash(vec2 p) {
	return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453);
}

void fragment() {
	vec3 world_pos = (INV_VIEW_MATRIX * vec4(VERTEX, 1.0)).xyz;
	vec2 grid = world_pos.xz * 0.22;
	vec2 cell = floor(grid);
	vec2 f = fract(grid);
	vec2 u = f * f * (3.0 - 2.0 * f);
	float n = mix(
			mix(cell_hash(cell), cell_hash(cell + vec2(1.0, 0.0)), u.x),
			mix(cell_hash(cell + vec2(0.0, 1.0)), cell_hash(cell + vec2(1.0, 1.0)), u.x),
			u.y);
	ALBEDO = mix(vec3(0.62, 0.47, 0.29), vec3(0.82, 0.66, 0.4), n);
	ROUGHNESS = 1.0;
}"

