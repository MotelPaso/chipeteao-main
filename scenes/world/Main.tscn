[sub_resource type="Shader" id="Shader_grid"]
code = "shader_type spatial;

// Placeholder floor: world-space 2m grid so movement speed is readable.
void fragment() {
	vec3 world_pos = (INV_VIEW_MATRIX * vec4(VERTEX, 1.0)).xyz;
	vec2 cell = abs(fract(world_pos.xz * 0.5) - vec2(0.5));
	float line = step(0.48, max(cell.x, cell.y));
	ALBEDO = mix(vec3(0.23, 0.27, 0.32), vec3(0.35, 0.75, 0.55), line);
	ROUGHNESS = 1.0;
}"

